   "outputs": [],
   "source": [
    "def triage_interrupt_handler(state: State, store: BaseStore) -> Command[Literal[\"response_agent\", \"__end__\"]]:\n",
    "    \"\"\"处理分类步骤的中断\"\"\"\n",
    "    \n",
    "    # 解析电子邮件输入\n",
    "    author, to, subject, email_thread = parse_email(state[\"email_input\"])\n",
    "\n",
    "    # 为通知情况创建电子邮件 markdown（Agent Inbox）\n",
    "    email_markdown = format_email_markdown(subject, author, to, email_thread)\n",
    "\n",
    "    # 创建消息\n",
    "    messages = [{\"role\": \"user\",\n",
    "                \"content\": f\"要通知用户的电子邮件：{email_markdown}\"\n",
    "                }]\n",
    "\n",
    "    # 为 Agent Inbox 创建中断\n",
    "    request = {\n",
    "        \"action_request\": {\n",
    "            \"action\": f\"电子邮件助手：{state['classification_decision']}\",\n",
    "            \"args\": {}\n",
    "        },\n",
    "        \"config\": {\n",
    "            \"allow_ignore\": True,  \n",
    "            \"allow_respond\": True,\n",
    "            \"allow_edit\": False, \n",
    "            \"allow_accept\": False,  \n",
    "        },\n",
    "        # 在 Agent Inbox 中显示的电子邮件\n",
    "        \"description\": email_markdown,\n",
    "    }\n",
    "\n",
    "    # 发送到 Agent Inbox 并等待响应\n",
    "    response = interrupt([request])[0]\n",
    "\n",
    "    # 如果用户提供反馈，转到响应智能体并使用反馈回复电子邮件\n",
    "    if response[\"type\"] == \"response\":\n",
    "        # 将反馈添加到消息\n",
    "        user_input = response[\"args\"]\n",
    "        messages.append({\"role\": \"user\",\n",
    "                        \"content\": f\"用户想要回复电子邮件。使用此反馈进行响应：{user_input}\"\n",
    "                        })\n",
    "        # 这是新的：使用反馈更新 triage_preferences\n",
    "        update_memory(store, (\"email_assistant\", \"triage_preferences\"), [{\n",
    "            \"role\": \"user\",\n",
    "            \"content\": f\"用户决定回复电子邮件，所以更新分类偏好以捕获这一点。\"\n",
    "        }] + messages)\n",
    "\n",
    "        goto = \"response_agent\"\n",
    "\n",
    "    # 如果用户忽略电子邮件，转到 END\n",
    "    elif response[\"type\"] == \"ignore\":\n",
    "        # 记下用户忽略电子邮件的决定\n",
    "        messages.append({\"role\": \"user\",\n",
    "                        \"content\": f\"用户决定忽略电子邮件，即使它被分类为通知。更新分类偏好以捕获这一点。\"\n",
    "                        })\n",
    "        # 这是新的：使用反馈更新 triage_preferences\n",
    "        update_memory(store, (\"email_assistant\", \"triage_preferences\"), messages)\n",
    "        goto = END\n",
    "\n",
    "    # 捕获所有其他响应\n",
    "    else:\n",
    "        raise ValueError(f\"无效的响应：{response}\")\n",
    "\n",
    "    # 更新状态\n",
    "    update = {\n",
    "        \"messages\": messages,\n",
    "    }\n",
    "\n",
    "    return Command(goto=goto, update=update)"
   ]
  },
