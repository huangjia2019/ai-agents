   "source": [
    "### 将记忆整合到 LLM 响应中\n",
    "\n",
    "现在我们已经设置了记忆管理器，我们可以在生成响应时使用存储的偏好"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a82b17a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def llm_call(state: State, store: BaseStore):\n",
    "    \"\"\"LLM 决定是否调用工具\"\"\"\n",
    "\n",
    "    # 搜索现有的 cal_preferences 记忆\n",
    "    cal_preferences = get_memory(store, (\"email_assistant\", \"cal_preferences\"), default_cal_preferences)\n",
    "    \n",
    "    # 搜索现有的 response_preferences 记忆\n",
    "    response_preferences = get_memory(store, (\"email_assistant\", \"response_preferences\"), default_response_preferences)\n",
    "\n",
    "    return {\n",
    "        \"messages\": [\n",
    "            llm_with_tools.invoke(\n",
    "                [\n",
    "                    {\"role\": \"system\", \"content\": agent_system_prompt_hitl_memory.format(tools_prompt=HITL_MEMORY_TOOLS_PROMPT,\n",
    "                                                                                         background=default_background,\n",
    "                                                                                         response_preferences=response_preferences, \n",
    "                                                                                         cal_preferences=cal_preferences)}\n",
    "                ]\n",
    "                + state[\"messages\"]\n",
    "            )\n",
    "        ]\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e60aff5d",
   "metadata": {},
   "source": [
    "### 中断处理程序中的记忆集成\n",
    "\n",
    "同样，我们将为中断处理程序添加记忆！"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "126d3680",
   "metadata": {},
   "outputs": [],
   "source": [
    "def interrupt_handler(state: State, store: BaseStore) -> Command[Literal[\"llm_call\", \"__end__\"]]:\n",
    "    \"\"\"为工具调用的人工审查创建中断\"\"\"\n",
    "    \n",
    "    # 存储消息\n",
    "    result = []\n",
    "\n",
    "    # 接下来转到 LLM 调用节点\n",
    "    goto = \"llm_call\"\n",
    "\n",
    "    # 遍历最后一条消息中的工具调用\n",
    "    for tool_call in state[\"messages\"][-1].tool_calls:\n",
    "        \n",
    "        # HITL 允许的工具\n",
    "        hitl_tools = [\"write_email\", \"schedule_meeting\", \"Question\"]\n",
    "        \n",
    "        # 如果工具不在我们的 HITL 列表中，直接执行而不中断\n",
    "        if tool_call[\"name\"] not in hitl_tools:\n",
    "\n",
    "            # 执行工具而不中断\n",
    "            tool = tools_by_name[tool_call[\"name\"]]\n",
    "            observation = tool.invoke(tool_call[\"args\"])\n",
    "            result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": tool_call[\"id\"]})\n",
    "            continue\n",
    "            \n",
    "        # 从状态中的 email_input 获取原始电子邮件\n",
    "        email_input = state[\"email_input\"]\n",
    "        author, to, subject, email_thread = parse_email(email_input)\n",
    "        original_email_markdown = format_email_markdown(subject, author, to, email_thread)\n",
    "        \n",
    "        # 格式化工具调用以供显示并在前面加上原始电子邮件\n",
    "        tool_display = format_for_display(tool_call)\n",
    "        description = original_email_markdown + tool_display\n",
    "\n",
    "        # 配置 Agent Inbox 中允许的操作\n",
    "        if tool_call[\"name\"] == \"write_email\":\n",
    "            config = {\n",
    "                \"allow_ignore\": True,\n",
    "                \"allow_respond\": True,\n",
    "                \"allow_edit\": True,\n",
    "                \"allow_accept\": True,\n",
    "            }\n",
    "        elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "            config = {\n",
    "                \"allow_ignore\": True,\n",
    "                \"allow_respond\": True,\n",
    "                \"allow_edit\": True,\n",
    "                \"allow_accept\": True,\n",
    "            }\n",
    "        elif tool_call[\"name\"] == \"Question\":\n",
    "            config = {\n",
    "                \"allow_ignore\": True,\n",
    "                \"allow_respond\": True,\n",
    "                \"allow_edit\": False,\n",
    "                \"allow_accept\": False,\n",
    "            }\n",
    "        else:\n",
    "            raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "        # 创建中断请求\n",
    "        request = {\n",
    "            \"action_request\": {\n",
    "                \"action\": tool_call[\"name\"],\n",
    "                \"args\": tool_call[\"args\"]\n",
    "            },\n",
    "            \"config\": config,\n",
    "            \"description\": description,\n",
    "        }\n",
    "\n",
    "        # 发送到 Agent Inbox 并等待响应\n",
    "        response = interrupt([request])[0]\n",
    "\n",
    "        # 处理响应\n",
    "        if response[\"type\"] == \"accept\":\n",
    "\n",
    "            # 使用原始参数执行工具\n",
    "            tool = tools_by_name[tool_call[\"name\"]]\n",
    "            observation = tool.invoke(tool_call[\"args\"])\n",
    "            result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": tool_call[\"id\"]})\n",
    "                        \n",
    "        elif response[\"type\"] == \"edit\":\n",
    "\n",
    "            # 工具选择\n",
    "            tool = tools_by_name[tool_call[\"name\"]]\n",
    "            initial_tool_call = tool_call[\"args\"]\n",
    "            \n",
    "            # 从 Agent Inbox 获取编辑的参数\n",
    "            edited_args = response[\"args\"][\"args\"]\n",
    "\n",
    "            # 使用编辑的内容更新 AI 消息的工具调用（对状态中消息的引用）\n",
    "            ai_message = state[\"messages\"][-1] # 从状态获取最新消息\n",
    "            current_id = tool_call[\"id\"] # 存储正在编辑的工具调用的 ID\n",
    "            \n",
    "            # 通过过滤掉正在编辑的工具调用并添加更新版本来创建新的工具调用列表\n",
    "            # 这避免了直接修改原始列表（不可变方法）\n",
    "            updated_tool_calls = [tc for tc in ai_message.tool_calls if tc[\"id\"] != current_id] + [\n",
    "                {\"type\": \"tool_call\", \"name\": tool_call[\"name\"], \"args\": edited_args, \"id\": current_id}\n",
    "            ]\n",
    "\n",
    "            # 创建带有更新工具调用的消息新副本，而不是修改原始消息\n",
    "            # 这确保状态不可变性并防止代码其他部分的副作用\n",
    "            # 当我们更新消息状态键（\"messages\": result）时，add_messages reducer 将\n",
    "            # 按 id 覆盖现有消息，我们在这里利用这一点来更新工具调用。\n",
    "            result.append(ai_message.model_copy(update={\"tool_calls\": updated_tool_calls}))\n",
    "\n",
    "            # 在记忆中保存反馈并使用来自 Agent Inbox 的编辑内容更新 write_email 工具调用\n",
    "            if tool_call[\"name\"] == \"write_email\":\n",
    "                \n",
    "                # 使用编辑的参数执行工具\n",
    "                observation = tool.invoke(edited_args)\n",
    "                \n",
    "                # 只添加工具响应消息\n",
    "                result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": current_id})\n",
    "\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"response_preferences\"), [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户编辑了电子邮件响应。这是助手生成的初始电子邮件：{initial_tool_call}。这是编辑后的电子邮件：{edited_args}。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "            \n",
    "            # 在记忆中保存反馈并使用来自 Agent Inbox 的编辑内容更新 schedule_meeting 工具调用\n",
    "            elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "                \n",
    "                # 使用编辑的参数执行工具\n",
    "                observation = tool.invoke(edited_args)\n",
    "                \n",
    "                # 只添加工具响应消息\n",
    "                result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": current_id})\n",
    "\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"cal_preferences\"), [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户编辑了日历邀请。这是助手生成的初始日历邀请：{initial_tool_call}。这是编辑后的日历邀请：{edited_args}。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "            \n",
    "            # 捕获所有其他工具调用\n",
    "            else:\n",
    "                raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "        elif response[\"type\"] == \"ignore\":\n",
    "\n",
    "            if tool_call[\"name\"] == \"write_email\":\n",
    "                # 不执行工具，并告诉智能体如何进行\n",
    "                result.append({\"role\": \"tool\", \"content\": \"用户忽略了这个电子邮件草稿。忽略这个电子邮件并结束工作流。\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 转到 END\n",
    "                goto = END\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"triage_preferences\"), state[\"messages\"] + result + [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户忽略了电子邮件草稿。这意味着他们不想回复电子邮件。更新分类偏好以确保此类电子邮件不被分类为响应。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "\n",
    "            elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "                # 不执行工具，并告诉智能体如何进行\n",
    "                result.append({\"role\": \"tool\", \"content\": \"用户忽略了这个日历会议草稿。忽略这个电子邮件并结束工作流。\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 转到 END\n",
    "                goto = END\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"triage_preferences\"), state[\"messages\"] + result + [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户忽略了日历会议草稿。这意味着他们不想为这封电子邮件安排会议。更新分类偏好以确保此类电子邮件不被分类为响应。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "\n",
    "            elif tool_call[\"name\"] == \"Question\":\n",
    "                # 不执行工具，并告诉智能体如何进行\n",
    "                result.append({\"role\": \"tool\", \"content\": \"用户忽略了这个问题。忽略这个电子邮件并结束工作流。\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 转到 END\n",
    "                goto = END\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"triage_preferences\"), state[\"messages\"] + result + [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户忽略了问题。这意味着他们不想回答问题或处理这封电子邮件。更新分类偏好以确保此类电子邮件不被分类为响应。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "\n",
    "            else:\n",
    "                raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "        elif response[\"type\"] == \"response\":\n",
    "            # 用户提供了反馈\n",
    "            user_feedback = response[\"args\"]\n",
    "            if tool_call[\"name\"] == \"write_email\":\n",
    "                # 不执行工具，并添加带有用户反馈的消息以合并到电子邮件中\n",
    "                result.append({\"role\": \"tool\", \"content\": f\"用户给出了反馈，我们可以将其合并到电子邮件中。反馈：{user_feedback}\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"response_preferences\"), state[\"messages\"] + result + [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户给出了反馈，我们可以用它来更新响应偏好。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "\n",
    "            elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "                # 不执行工具，并添加带有用户反馈的消息以合并到会议请求中\n",
    "                result.append({\"role\": \"tool\", \"content\": f\"用户给出了反馈，我们可以将其合并到会议请求中。反馈：{user_feedback}\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 这是新的：更新记忆\n",
    "                update_memory(store, (\"email_assistant\", \"cal_preferences\"), state[\"messages\"] + result + [{\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": f\"用户给出了反馈，我们可以用它来更新日历偏好。遵循上述所有指令，记住：{MEMORY_UPDATE_INSTRUCTIONS_REINFORCEMENT}。\"\n",
    "                }])\n",
    "\n",
    "            elif tool_call[\"name\"] == \"Question\":\n",
    "                # 不执行工具，并添加带有用户反馈的消息以用于任何后续操作\n",
    "                result.append({\"role\": \"tool\", \"content\": f\"用户回答了问题，我们可以用于任何后续操作。反馈：{user_feedback}\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "\n",
    "            else:\n",
    "                raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "    # 更新状态\n",
    "    update = {\n",
    "        \"messages\": result,\n",
    "    }\n",
    "\n",
    "    return Command(goto=goto, update=update)"
   ]
