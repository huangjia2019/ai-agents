  {
   "cell_type": "markdown",
   "id": "2566464d",
   "metadata": {},
   "source": [
    "## 为我们的电子邮件助手添加 HITL\n",
    "\n",
    "让我们为我们的电子邮件助手添加 HITL。\n",
    "\n",
    "我们可以从工具开始，就像之前一样。\n",
    "\n",
    "但现在，我们将添加一个新工具 Question，允许助手向用户提问。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6d4dfb07",
   "metadata": {},
   "outputs": [],
   "source": [
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "\n",
    "from typing import Literal\n",
    "from datetime import datetime\n",
    "from pydantic import BaseModel\n",
    "\n",
    "from langchain.chat_models import init_chat_model\n",
    "from langchain_core.tools import tool\n",
    "\n",
    "from langgraph.graph import StateGraph, START, END\n",
    "from langgraph.types import interrupt, Command\n",
    "\n",
    "from email_assistant.prompts import triage_system_prompt, triage_user_prompt, agent_system_prompt_hitl, default_background, default_triage_instructions, default_response_preferences, default_cal_preferences\n",
    "from email_assistant.tools.default.prompt_templates import HITL_TOOLS_PROMPT\n",
    "from email_assistant.schemas import State, RouterSchema, StateInput\n",
    "from email_assistant.utils import parse_email, format_for_display, format_email_markdown\n",
    "\n",
    "# 智能体工具\n",
    "@tool\n",
    "def write_email(to: str, subject: str, content: str) -> str:\n",
    "    \"\"\"撰写并发送电子邮件。\"\"\"\n",
    "    # 占位符响应 - 在真实应用中会发送电子邮件\n",
    "    return f\"电子邮件已发送至 {to}，主题为 '{subject}'，内容为：{content}\"\n",
    "\n",
    "@tool\n",
    "def schedule_meeting(\n",
    "    attendees: list[str], subject: str, duration_minutes: int, preferred_day: datetime, start_time: int\n",
    ") -> str:\n",
    "    \"\"\"安排日历会议。\"\"\"\n",
    "    # 占位符响应 - 在真实应用中会检查日历并安排会议\n",
    "    date_str = preferred_day.strftime(\"%A, %B %d, %Y\")\n",
    "    return f\"会议 '{subject}' 已安排在 {date_str} {start_time} 点，持续 {duration_minutes} 分钟，有 {len(attendees)} 位参与者\"\n",
    "\n",
    "@tool\n",
    "def check_calendar_availability(day: str) -> str:\n",
    "    \"\"\"检查指定日期的日历可用性。\"\"\"\n",
    "    # 占位符响应 - 在真实应用中会检查实际日历\n",
    "    return f\"{day} 的可用时间：上午9:00，下午2:00，下午4:00\"\n",
    "\n",
    "@tool\n",
    "# 这是新的！\n",
    "class Question(BaseModel):\n",
    "      \"\"\"要问用户的问题。\"\"\"\n",
    "      content: str\n",
    "    \n",
    "@tool\n",
    "class Done(BaseModel):\n",
    "      \"\"\"电子邮件已发送。\"\"\"\n",
    "      done: bool\n",
    "\n",
    "# 智能体可用的所有工具\n",
    "tools = [\n",
    "    write_email, \n",
    "    schedule_meeting, \n",
    "    check_calendar_availability, \n",
    "    Question, \n",
    "    Done,\n",
    "]\n",
    "\n",
    "tools_by_name = {tool.name: tool for tool in tools}\n",
    "\n",
    "# 初始化用于路由器/结构化输出的 LLM\n",
    "llm = init_chat_model(\"openai:gpt-4.1\", temperature=0.0)\n",
    "llm_router = llm.with_structured_output(RouterSchema) \n",
    "\n",
    "# 初始化 LLM，强制智能体使用工具（任何可用工具）\n",
    "llm = init_chat_model(\"openai:gpt-4.1\", temperature=0.0)\n",
    "llm_with_tools = llm.bind_tools(tools, tool_choice=\"required\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bf05b260-9809-4f32-807b-abe1632e4181",
   "metadata": {},
   "outputs": [],
   "source": [
    "from rich.markdown import Markdown\n",
    "Markdown(HITL_TOOLS_PROMPT)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b9f8f334",
   "metadata": {},
   "source": [
    "#### 分类节点\n",
    "\n",
    "我们像之前一样定义一个带有分类路由逻辑的 Python 函数。\n",
    "\n",
    "但是，如果分类是 `notify`，我们想要中断图以允许用户审查电子邮件！\n",
    "\n",
    "所以我们转到一个新节点，`triage_interrupt_handler`。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "65efb689",
   "metadata": {},
   "outputs": [],
   "source": [
    "def triage_router(state: State) -> Command[Literal[\"triage_interrupt_handler\", \"response_agent\", \"__end__\"]]:\n",
    "    \"\"\"分析电子邮件内容以决定是否应该响应、通知或忽略。\"\"\"\n",
    "\n",
    "    # 解析电子邮件输入\n",
    "    author, to, subject, email_thread = parse_email(state[\"email_input\"])\n",
    "    user_prompt = triage_user_prompt.format(\n",
    "        author=author, to=to, subject=subject, email_thread=email_thread\n",
    "    )\n",
    "\n",
    "    # 为通知情况创建电子邮件 markdown（Agent Inbox）\n",
    "    email_markdown = format_email_markdown(subject, author, to, email_thread)\n",
    "\n",
    "    # 使用背景和分类指令格式化系统提示\n",
    "    system_prompt = triage_system_prompt.format(\n",
    "        background=default_background,\n",
    "        triage_instructions=default_triage_instructions\n",
    "    )\n",
    "\n",
    "    # 运行路由器 LLM\n",
    "    result = llm_router.invoke(\n",
    "        [\n",
    "            {\"role\": \"system\", \"content\": system_prompt},\n",
    "            {\"role\": \"user\", \"content\": user_prompt},\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    # 决策\n",
    "    classification = result.classification\n",
    "\n",
    "    # 处理分类决策\n",
    "    if classification == \"respond\":\n",
    "        print(\"📧 分类：响应 - 这封电子邮件需要回复\")\n",
    "        # 下一个节点\n",
    "        goto = \"response_agent\"\n",
    "        # 更新状态\n",
    "        update = {\n",
    "            \"classification_decision\": classification,\n",
    "            \"messages\": [{\"role\": \"user\",\n",
    "                            \"content\": f\"回复电子邮件：{email_markdown}\"\n",
    "                        }],\n",
    "        }\n",
    "    elif classification == \"ignore\":\n",
    "        print(\"🚫 分类：忽略 - 这封电子邮件可以安全忽略\")\n",
    "        # 下一个节点\n",
    "        goto = END\n",
    "        # 更新状态\n",
    "        update = {\n",
    "            \"classification_decision\": classification,\n",
    "        }\n",
    "\n",
    "    elif classification == \"notify\":\n",
    "        print(\"🔔 分类：通知 - 这封电子邮件包含重要信息\")\n",
    "        # 这是新的！\n",
    "        goto = \"triage_interrupt_handler\"\n",
    "        # 更新状态\n",
    "        update = {\n",
    "            \"classification_decision\": classification,\n",
    "        }\n",
    "\n",
    "    else:\n",
    "        raise ValueError(f\"无效的分类：{classification}\")\n",
    "    return Command(goto=goto, update=update)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4a1f564a",
   "metadata": {},
   "source": [
    "#### 分类中断处理器\n",
    "\n",
    "如果决定是 `notify` 用户，我们中断图！\n",
    "\n",
    "![overview-img](img/HITL_flow_triage.png)\n",
    "\n",
    "为此，我们添加一个新节点 `triage_interrupt_handler`，它将：\n",
    "\n",
    "1. 如果分类是 `notify`，向用户显示分类：我们将传递一个包含我们分类的 `dict` 给中断。\n",
    "2. 允许用户响应决策：我们将设计代码来处理从 Agent Inbox 返回的内容。\n",
    "\n",
    "正如您在[这里](https://github.com/langchain-ai/agent-inbox?tab=readme-ov-file#what-do-the-fields-mean)看到的，我们使用特定字段格式化我们的中断，以便它可以在 Agent Inbox 中查看：\n",
    "\n",
    "* `action_request`：带有 `action`（操作名称）和 `args`（工具调用参数）的中断的操作和参数。这在 Agent Inbox 中呈现为中断事件的主标题。\n",
    "* `config`：配置允许哪些交互类型以及每种类型的特定 UI 元素。\n",
    "* `description`：应该详细，可以是 markdown。这将在 Agent Inbox 中呈现为描述"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "203346bb",
   "metadata": {},
   "outputs": [],
   "source": [
    "def triage_interrupt_handler(state: State) -> Command[Literal[\"response_agent\", \"__end__\"]]:\n",
    "    \"\"\"处理分类步骤的中断。\"\"\"\n",
    "    \n",
    "    # 解析电子邮件输入\n",
    "    author, to, subject, email_thread = parse_email(state[\"email_input\"])\n",
    "\n",
    "    # 为通知情况创建电子邮件 markdown（Agent Inbox）\n",
    "    email_markdown = format_email_markdown(subject, author, to, email_thread)\n",
    "\n",
    "    # 创建消息\n",
    "    messages = [{\"role\": \"user\",\n",
    "                \"content\": f\"要通知用户的电子邮件：{email_markdown}\"\n",
    "                }]\n",
    "\n",
    "    # 创建显示给用户的中断\n",
    "    request = {\n",
    "        \"action_request\": {\n",
    "            \"action\": f\"电子邮件助手：{state['classification_decision']}\",\n",
    "            \"args\": {}\n",
    "        },\n",
    "        \"config\": {\n",
    "            \"allow_ignore\": True,  \n",
    "            \"allow_respond\": True, \n",
    "            \"allow_edit\": False, \n",
    "            \"allow_accept\": False,  \n",
    "        },\n",
    "        # 在 Agent Inbox 中显示的电子邮件\n",
    "        \"description\": email_markdown,\n",
    "    }\n",
    "\n",
    "    # Agent Inbox 使用包含单个键 `type` 的字典列表响应，可以是 `accept`、`edit`、`ignore` 或 `response`。\n",
    "    response = interrupt([request])[0]\n",
    "\n",
    "    # 如果用户提供反馈，转到响应智能体并使用反馈回复电子邮件\n",
    "    if response[\"type\"] == \"response\":\n",
    "        # 将反馈添加到消息\n",
    "        user_input = response[\"args\"]\n",
    "        # 被响应智能体使用\n",
    "        messages.append({\"role\": \"user\",\n",
    "                        \"content\": f\"用户想要回复电子邮件。使用此反馈进行响应：{user_input}\"\n",
    "                        })\n",
    "        # 转到响应智能体\n",
    "        goto = \"response_agent\"\n",
    "\n",
    "    # 如果用户忽略电子邮件，转到 END\n",
    "    elif response[\"type\"] == \"ignore\":\n",
    "        goto = END\n",
    "\n",
    "    # 捕获所有其他响应\n",
    "    else:\n",
    "        raise ValueError(f\"无效的响应：{response}\")\n",
    "\n",
    "    # 更新状态\n",
    "    update = {\n",
    "        \"messages\": messages,\n",
    "    }\n",
    "\n",
    "    return Command(goto=goto, update=update)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8613e4c4",
   "metadata": {},
   "source": [
    "#### LLM 调用\n",
    "\n",
    "`llm_call` 节点与之前相同："
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "036aba96",
   "metadata": {},
   "outputs": [],
   "source": [
    "def llm_call(state: State):\n",
    "    \"\"\"LLM 决定是否调用工具。\"\"\"\n",
    "\n",
    "    return {\n",
    "        \"messages\": [\n",
    "            llm_with_tools.invoke(\n",
    "                [\n",
    "                    {\"role\": \"system\", \"content\": agent_system_prompt_hitl.format(tools_prompt=HITL_TOOLS_PROMPT, \n",
    "                                                                                  background=default_background,\n",
    "                                                                                  response_preferences=default_response_preferences, \n",
    "                                                                                  cal_preferences=default_cal_preferences)}\n",
    "                ]\n",
    "                + state[\"messages\"]\n",
    "            )\n",
    "        ]\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "397516ee",
   "metadata": {},
   "source": [
    "#### 中断处理器\n",
    "\n",
    "`interrupt_handler` 是我们响应智能体的核心 HITL 组件。\n",
    "\n",
    "它的工作是检查 LLM 想要进行的工具调用，并确定哪些需要在执行前进行人工审查。以下是它的工作方式：\n",
    "\n",
    "1. **工具选择**：处理器维护需要人工批准的"HITL 工具"列表：\n",
    "   - `write_email`：因为发送电子邮件有显著的外部影响\n",
    "   - `schedule_meeting`：因为安排会议会影响日历\n",
    "   - `Question`：因为向用户提问需要直接交互\n",
    "\n",
    "2. **直接执行**：不在 HITL 列表中的工具（如 `check_calendar_availability`）立即执行而不中断。这允许低风险操作自动进行。\n",
    "\n",
    "3. **上下文准备**：对于需要审查的工具，处理器：\n",
    "   - 检索原始电子邮件以获取上下文\n",
    "   - 格式化工具调用详细信息以便清晰显示\n",
    "   - 配置每种工具类型允许的交互类型\n",
    "\n",
    "4. **中断创建**：处理器创建结构化的中断请求，包含：\n",
    "   - 操作名称和参数\n",
    "   - 允许的交互类型配置\n",
    "   - 包含原始电子邮件和建议操作的描述\n",
    "\n",
    "5. **响应处理**：中断后，处理器处理人工响应：\n",
    "   - **接受**：使用原始参数执行工具\n",
    "   - **编辑**：使用编辑后的参数更新工具调用然后执行\n",
    "   - **忽略**：取消工具执行\n",
    "   - **响应**：记录反馈而不执行\n",
    "\n",
    "该处理器确保人类对所有重要操作有监督，同时允许例行操作自动进行。\n",
    "\n",
    "编辑工具参数（如电子邮件内容或会议详细信息）的能力为用户提供了对助手操作的精确控制。\n",
    "\n",
    "我们可以可视化整体流程：\n",
    "\n",
    "![overview-img](img/HITL_flow.png)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f41929d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def interrupt_handler(state: State) -> Command[Literal[\"llm_call\", \"__end__\"]]:\n",
    "    \"\"\"为工具调用的人工审查创建中断\"\"\"\n",
    "    \n",
    "    # 存储消息\n",
    "    result = []\n",
    "\n",
    "    # 接下来转到 LLM 调用节点\n",
    "    goto = \"llm_call\"\n",
    "\n",
    "    # 遍历最后一条消息中的工具调用\n",
    "    for tool_call in state[\"messages\"][-1].tool_calls:\n",
    "        \n",
    "        # HITL 允许的工具\n",
    "        hitl_tools = [\"write_email\", \"schedule_meeting\", \"Question\"]\n",
    "        \n",
    "        # 如果工具不在我们的 HITL 列表中，直接执行而不中断\n",
    "        if tool_call[\"name\"] not in hitl_tools:\n",
    "\n",
    "            # 执行工具而不中断\n",
    "            tool = tools_by_name[tool_call[\"name\"]]\n",
    "            observation = tool.invoke(tool_call[\"args\"])\n",
    "            result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": tool_call[\"id\"]})\n",
    "            continue\n",
    "            \n",
    "        # 从状态中的 email_input 获取原始电子邮件\n",
    "        email_input = state[\"email_input\"]\n",
    "        author, to, subject, email_thread = parse_email(email_input)\n",
    "        original_email_markdown = format_email_markdown(subject, author, to, email_thread)\n",
    "        \n",
    "        # 格式化工具调用以供显示并在前面加上原始电子邮件\n",
    "        tool_display = format_for_display(tool_call)\n",
    "        description = original_email_markdown + tool_display\n",
    "\n",
    "        # 配置 Agent Inbox 中允许的操作\n",
    "        if tool_call[\"name\"] == \"write_email\":\n",
    "            config = {\n",
    "                \"allow_ignore\": True,\n",
    "                \"allow_respond\": True,\n",
    "                \"allow_edit\": True,\n",
    "                \"allow_accept\": True,\n",
    "            }\n",
    "        elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "            config = {\n",
    "                \"allow_ignore\": True,\n",
    "                \"allow_respond\": True,\n",
    "                \"allow_edit\": True,\n",
    "                \"allow_accept\": True,\n",
    "            }\n",
    "        elif tool_call[\"name\"] == \"Question\":\n",
    "            config = {\n",
    "                \"allow_ignore\": True,\n",
    "                \"allow_respond\": True,\n",
    "                \"allow_edit\": False,\n",
    "                \"allow_accept\": False,\n",
    "            }\n",
    "        else:\n",
    "            raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "        # 创建中断请求\n",
    "        request = {\n",
    "            \"action_request\": {\n",
    "                \"action\": tool_call[\"name\"],\n",
    "                \"args\": tool_call[\"args\"]\n",
    "            },\n",
    "            \"config\": config,\n",
    "            \"description\": description,\n",
    "        }\n",
    "\n",
    "        # 发送到 Agent Inbox 并等待响应\n",
    "        response = interrupt([request])[0]\n",
    "\n",
    "        # 处理响应\n",
    "        if response[\"type\"] == \"accept\":\n",
    "\n",
    "            # 使用原始参数执行工具\n",
    "            tool = tools_by_name[tool_call[\"name\"]]\n",
    "            observation = tool.invoke(tool_call[\"args\"])\n",
    "            result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": tool_call[\"id\"]})\n",
    "                        \n",
    "        elif response[\"type\"] == \"edit\":\n",
    "\n",
    "            # 工具选择\n",
    "            tool = tools_by_name[tool_call[\"name\"]]\n",
    "            \n",
    "            # 从 Agent Inbox 获取编辑的参数\n",
    "            edited_args = response[\"args\"][\"args\"]\n",
    "\n",
    "            # 使用编辑的内容更新 AI 消息的工具调用（对状态中消息的引用）\n",
    "            ai_message = state[\"messages\"][-1] # 从状态获取最新消息\n",
    "            current_id = tool_call[\"id\"] # 存储正在编辑的工具调用的 ID\n",
    "            \n",
    "            # 通过过滤掉正在编辑的工具调用并添加更新版本来创建新的工具调用列表\n",
    "            # 这避免了直接修改原始列表（不可变方法）\n",
    "            updated_tool_calls = [tc for tc in ai_message.tool_calls if tc[\"id\"] != current_id] + [\n",
    "                {\"type\": \"tool_call\", \"name\": tool_call[\"name\"], \"args\": edited_args, \"id\": current_id}\n",
    "            ]\n",
    "            \n",
    "            # 创建带有更新工具调用的消息新副本，而不是修改原始消息\n",
    "            # 这确保状态不可变性并防止代码其他部分的副作用\n",
    "            # 当我们更新消息状态键（\"messages\": result）时，add_messages reducer 将\n",
    "            # 按 id 覆盖现有消息，我们在这里利用这一点来更新工具调用。\n",
    "            result.append(ai_message.model_copy(update={\"tool_calls\": updated_tool_calls}))\n",
    "\n",
    "            # 使用来自 Agent Inbox 的编辑内容更新 write_email 工具调用\n",
    "            if tool_call[\"name\"] == \"write_email\":\n",
    "                \n",
    "                # 使用编辑的参数执行工具\n",
    "                observation = tool.invoke(edited_args)\n",
    "                \n",
    "                # 只添加工具响应消息\n",
    "                result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": current_id})\n",
    "            \n",
    "            # 使用来自 Agent Inbox 的编辑内容更新 schedule_meeting 工具调用\n",
    "            elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "                \n",
    "                \n",
    "                # 使用编辑的参数执行工具\n",
    "                observation = tool.invoke(edited_args)\n",
    "                \n",
    "                # 只添加工具响应消息\n",
    "                result.append({\"role\": \"tool\", \"content\": observation, \"tool_call_id\": current_id})\n",
    "            \n",
    "            # 捕获所有其他工具调用\n",
    "            else:\n",
    "                raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "        elif response[\"type\"] == \"ignore\":\n",
    "            if tool_call[\"name\"] == \"write_email\":\n",
    "                # 不执行工具，并告诉智能体如何进行\n",
    "                result.append({\"role\": \"tool\", \"content\": \"用户忽略了这个电子邮件草稿。忽略这个电子邮件并结束工作流。\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 转到 END\n",
    "                goto = END\n",
    "            elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "                # 不执行工具，并告诉智能体如何进行\n",
    "                result.append({\"role\": \"tool\", \"content\": \"用户忽略了这个日历会议草稿。忽略这个电子邮件并结束工作流。\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 转到 END\n",
    "                goto = END\n",
    "            elif tool_call[\"name\"] == \"Question\":\n",
    "                # 不执行工具，并告诉智能体如何进行\n",
    "                result.append({\"role\": \"tool\", \"content\": \"用户忽略了这个问题。忽略这个电子邮件并结束工作流。\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "                # 转到 END\n",
    "                goto = END\n",
    "            else:\n",
    "                raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "            \n",
    "        elif response[\"type\"] == \"response\":\n",
    "            # 用户提供了反馈\n",
    "            user_feedback = response[\"args\"]\n",
    "            if tool_call[\"name\"] == \"write_email\":\n",
    "                # 不执行工具，并添加带有用户反馈的消息以合并到电子邮件中\n",
    "                result.append({\"role\": \"tool\", \"content\": f\"用户给出了反馈，我们可以将其合并到电子邮件中。反馈：{user_feedback}\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "            elif tool_call[\"name\"] == \"schedule_meeting\":\n",
    "                # 不执行工具，并添加带有用户反馈的消息以合并到会议请求中\n",
    "                result.append({\"role\": \"tool\", \"content\": f\"用户给出了反馈，我们可以将其合并到会议请求中。反馈：{user_feedback}\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "            elif tool_call[\"name\"] == \"Question\": \n",
    "                # 不执行工具，并添加带有用户反馈的消息以用于任何后续操作\n",
    "                result.append({\"role\": \"tool\", \"content\": f\"用户回答了问题，我们可以用于任何后续操作。反馈：{user_feedback}\", \"tool_call_id\": tool_call[\"id\"]})\n",
    "            else:\n",
    "                raise ValueError(f\"无效的工具调用：{tool_call['name']}\")\n",
    "\n",
    "        # 捕获所有其他响应\n",
    "        else:\n",
    "            raise ValueError(f\"无效的响应：{response}\")\n",
    "            \n",
    "    # 更新状态\n",
    "    update = {\n",
    "        \"messages\": result,\n",
    "    }\n",
    "\n",
    "    return Command(goto=goto, update=update)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "164b0897",
   "metadata": {},
   "source": [
    "现在，让我们编译图。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3b6d1013",
   "metadata": {},
   "outputs": [],
   "source": [
    "from email_assistant.utils import show_graph\n",
    "\n",
    "# 条件边函数\n",
    "def should_continue(state: State) -> Literal[\"interrupt_handler\", \"__end__\"]:\n",
    "    \"\"\"路由到工具处理器，或如果调用了 Done 工具则结束\"\"\"\n",
    "    messages = state[\"messages\"]\n",
    "    last_message = messages[-1]\n",
    "    if last_message.tool_calls:\n",
    "        for tool_call in last_message.tool_calls: \n",
    "            if tool_call[\"name\"] == \"Done\":\n",
    "                return END\n",
    "            else:\n",
    "                return \"interrupt_handler\"\n",
    "\n",
    "# 构建工作流\n",
    "agent_builder = StateGraph(State)\n",
    "\n",
    "# 添加节点\n",
    "agent_builder.add_node(\"llm_call\", llm_call)\n",
    "agent_builder.add_node(\"interrupt_handler\", interrupt_handler)\n",
    "\n",
    "# 添加边\n",
    "agent_builder.add_edge(START, \"llm_call\")\n",
    "agent_builder.add_conditional_edge(\n",
    "    \"llm_call\",\n",
    "    should_continue,\n",
    "    {\n",
    "        \"interrupt_handler\": \"interrupt_handler\",\n",
    "        END: END,\n",
    "    },\n",
    ")\n",
    "\n",
    "# 编译智能体\n",
    "response_agent = agent_builder.compile()\n",
    "\n",
    "# 构建整体工作流\n",
    "overall_workflow = (\n",
    "    StateGraph(State, input=StateInput)\n",
    "    .add_node(triage_router)\n",
    "    .add_node(triage_interrupt_handler)\n",
    "    .add_node(\"response_agent\", response_agent)\n",
    "    .add_edge(START, \"triage_router\")\n",
    "    \n",
    ")\n",
    "\n",
    "email_assistant = overall_workflow.compile()\n",
    "show_graph(email_assistant, xray=True)"
   ]
  },
