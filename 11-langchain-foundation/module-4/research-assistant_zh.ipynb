   "source": [
    "### 并行化采访：Map-Reduce\n",
    "\n",
    "我们通过 `Send()` API 并行化采访，这是一个 map 步骤。\n",
    "\n",
    "我们在 reduce 步骤中将它们合并到报告主体中。\n",
    "\n",
    "### 完成\n",
    "\n",
    "我们添加最后一步为最终报告写介绍和结论。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6a0042f9-5b9f-441a-9e8d-7d8189f44140",
   "metadata": {},
   "outputs": [],
   "source": [
    "import operator\n",
    "from typing import List, Annotated\n",
    "from typing_extensions import TypedDict\n",
    "\n",
    "class ResearchGraphState(TypedDict):\n",
    "    topic: str # 研究主题\n",
    "    max_analysts: int # 分析师数量\n",
    "    human_analyst_feedback: str # 人工反馈\n",
    "    analysts: List[Analyst] # 提问的分析师\n",
    "    sections: Annotated[list, operator.add] # Send() API 键\n",
    "    introduction: str # 最终报告的介绍\n",
    "    content: str # 最终报告的内容\n",
    "    conclusion: str # 最终报告的结论\n",
    "    final_report: str # 最终报告"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c2224592-d2ff-469d-97bd-928809f896d7",
   "metadata": {},
   "outputs": [],
   "source": [
    "from langgraph.constants import Send\n",
    "\n",
    "def initiate_all_interviews(state: ResearchGraphState):\n",
    "    \"\"\" 这是"map"步骤，我们使用 Send API 运行每个采访子图 \"\"\"    \n",
    "\n",
    "    # 检查是否有人工反馈\n",
    "    human_analyst_feedback=state.get('human_analyst_feedback')\n",
    "    if human_analyst_feedback:\n",
    "        # 返回到 create_analysts\n",
    "        return \"create_analysts\"\n",
    "\n",
    "    # 否则通过 Send() API 并行启动采访\n",
    "    else:\n",
    "        topic = state[\"topic\"]\n",
    "        return [Send(\"conduct_interview\", {\"analyst\": analyst,\n",
    "                                           \"messages\": [HumanMessage(\n",
    "                                               content=f\"所以您说您正在写一篇关于 {topic} 的文章？\"\n",
    "                                           )\n",
    "                                                       ]}) for analyst in state[\"analysts\"]]\n",
    "\n",
    "report_writer_instructions = \"\"\"您是一位技术作家，正在创建关于这个总体主题的报告：\n",
    "\n",
    "{topic}\n",
    "    \n",
    "您有一个分析师团队。每个分析师做了两件事：\n",
    "\n",
    "1. 他们对特定子主题的专家进行了采访。\n",
    "2. 他们将发现写成备忘录。\n",
    "\n",
    "您的任务：\n",
    "\n",
    "1. 您将收到来自分析师的备忘录集合。\n",
    "2. 仔细思考每个备忘录的见解。\n",
    "3. 将这些整合成一个清晰的总体摘要，将所有备忘录的核心思想联系起来。\n",
    "4. 将每个备忘录中的核心点总结成一个连贯的单一叙述。\n",
    "\n",
    "格式化您的报告：\n",
    " \n",
    "1. 使用 markdown 格式。\n",
    "2. 报告不包含前言。\n",
    "3. 不使用子标题。\n",
    "4. 用单个标题标题开始您的报告：## 见解\n",
    "5. 在您的报告中不要提及任何分析师姓名。\n",
    "6. 保留备忘录中的任何引用，这些将用括号注释，例如 [1] 或 [2]。\n",
    "7. 创建最终的、整合的源列表并添加到带有 `## 源` 标题的源部分。\n",
    "8. 按顺序列出您的源，不要重复。\n",
    "\n",
    "[1] 源 1\n",
    "[2] 源 2\n",
    "\n",
    "以下是您分析师的备忘录，用于构建您的报告：\n",
    "\n",
    "{context}\"\"\"\n",
    "\n",
    "def write_report(state: ResearchGraphState):\n",
    "    # 完整的部分集\n",
    "    sections = state[\"sections\"]\n",
    "    topic = state[\"topic\"]\n",
    "\n",
    "    # 将所有部分连接在一起\n",
    "    formatted_str_sections = \"\\n\\n\".join([f\"{section}\" for section in sections])\n",
    "    \n",
    "    # 将部分总结成最终报告\n",
    "    system_message = report_writer_instructions.format(topic=topic, context=formatted_str_sections)    \n",
    "    report = llm.invoke([SystemMessage(content=system_message)]+[HumanMessage(content=f\"基于这些备忘录写一份报告。\")]) \n",
    "    return {\"content\": report.content}\n",
    "\n",
    "intro_conclusion_instructions = \"\"\"您是一位正在完成关于 {topic} 报告的技术作家\n",
    "\n",
    "您将收到报告的所有部分。\n",
    "\n",
    "您的工作是写一个清晰而引人注目的介绍或结论部分。\n",
    "\n",
    "用户将指示您是写介绍还是结论。\n",
    "\n",
    "任何部分都不包含前言。\n",
    "\n",
    "目标大约 100 字，清晰地预览（对于介绍）或回顾（对于结论）报告的所有部分。\n",
    "\n",
    "使用 markdown 格式。\n",
    "\n",
    "对于您的介绍，创建一个引人注目的标题并为标题使用 # 标题。\n",
    "\n",
    "对于您的介绍，使用 ## 介绍作为部分标题。\n",
    "\n",
    "对于您的结论，使用 ## 结论作为部分标题。\n",
    "\n",
    "以下是要反思写作的部分: {formatted_str_sections}\"\"\"\n",
    "\n",
    "def write_introduction(state: ResearchGraphState):\n",
    "    # 完整的部分集\n",
    "    sections = state[\"sections\"]\n",
    "    topic = state[\"topic\"]\n",
    "\n",
    "    # 将所有部分连接在一起\n",
    "    formatted_str_sections = \"\\n\\n\".join([f\"{section}\" for section in sections])\n",
    "    \n",
    "    # 将部分总结成最终报告\n",
    "    \n",
    "    instructions = intro_conclusion_instructions.format(topic=topic, formatted_str_sections=formatted_str_sections)    \n",
    "    intro = llm.invoke([instructions]+[HumanMessage(content=f\"写报告介绍\")]) \n",
    "    return {\"introduction\": intro.content}\n",
    "\n",
    "def write_conclusion(state: ResearchGraphState):\n",
    "    # 完整的部分集\n",
    "    sections = state[\"sections\"]\n",
    "    topic = state[\"topic\"]\n",
    "\n",
    "    # 将所有部分连接在一起\n",
    "    formatted_str_sections = \"\\n\\n\".join([f\"{section}\" for section in sections])\n",
    "    \n",
    "    # 将部分总结成最终报告\n",
    "    \n",
    "    instructions = intro_conclusion_instructions.format(topic=topic, formatted_str_sections=formatted_str_sections)    \n",
    "    conclusion = llm.invoke([instructions]+[HumanMessage(content=f\"写报告结论\")]) \n",
    "    return {\"conclusion\": conclusion.content}\n",
    "\n",
    "def finalize_report(state: ResearchGraphState):\n",
    "    \"\"\" 这是"reduce"步骤，我们收集所有部分，合并它们，并反思它们以写介绍/结论 \"\"\"\n",
    "    # 保存完整的最终报告\n",
    "    content = state[\"content\"]\n",
    "    if content.startswith(\"## 见解\"):\n",
    "        content = content.strip(\"## 见解\")\n",
    "    if \"## 源\" in content:\n",
    "        try:\n",
    "            content, sources = content.split(\"\\n## 源\\n\")\n",
    "        except:\n",
    "            sources = None\n",
    "    else:\n",
    "        sources = None\n",
    "\n",
    "    final_report = state[\"introduction\"] + \"\\n\\n---\\n\\n\" + content + \"\\n\\n---\\n\\n\" + state[\"conclusion\"]\n",
    "    if sources is not None:\n",
    "        final_report += \"\\n\\n## 源\\n\" + sources\n",
    "    return {\"final_report\": final_report}\n",
    "\n",
    "# 添加节点和边\n",
    "builder = StateGraph(ResearchGraphState)\n",
    "builder.add_node(\"create_analysts\", create_analysts)\n",
    "builder.add_node(\"human_feedback\", human_feedback)\n",
    "builder.add_node(\"conduct_interview\", interview_builder.compile())\n",
    "builder.add_node(\"write_report\",write_report)\n",
    "builder.add_node(\"write_introduction\",write_introduction)\n",
    "builder.add_node(\"write_conclusion\",write_conclusion)\n",
    "builder.add_node(\"finalize_report\",finalize_report)\n",
    "\n",
    "# 逻辑\n",
    "builder.add_edge(START, \"create_analysts\")\n",
    "builder.add_edge(\"create_analysts\", \"human_feedback\")\n",
    "builder.add_conditional_edges(\"human_feedback\", initiate_all_interviews, [\"create_analysts\", \"conduct_interview\"])\n",
    "builder.add_edge(\"conduct_interview\", \"write_report\")\n",
    "builder.add_edge(\"conduct_interview\", \"write_introduction\")\n",
    "builder.add_edge(\"conduct_interview\", \"write_conclusion\")\n",
    "builder.add_edge([\"write_conclusion\", \"write_report\", \"write_introduction\"], \"finalize_report\")\n",
    "builder.add_edge(\"finalize_report\", END)\n",
    "\n",
    "# 编译\n",
    "memory = MemorySaver()\n",
    "graph = builder.compile(interrupt_before=['human_feedback'], checkpointer=memory)\n",
    "display(Image(graph.get_graph(xray=1).draw_mermaid_png()))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1b64ba9a-2b5e-40e1-a778-0f635aa3f6d0",
   "metadata": {},
   "source": [
    "让我们问一个关于 LangGraph 的开放性问题。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "362932ee-4106-4a2d-a32d-b812eafcf9df",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 输入\n",
    "max_analysts = 3 \n",
    "topic = \"采用 LangGraph 作为智能体框架的好处\"\n",
    "thread = {\"configurable\": {\"thread_id\": \"1\"}}\n",
    "\n",
    "# 运行图直到第一次中断\n",
    "for event in graph.stream({\"topic\":topic,\n",
    "                           \"max_analysts\":max_analysts}, \n",
    "                          thread, \n",
    "                          stream_mode=\"values\"):\n",
    "    \n",
    "    analysts = event.get('analysts', '')\n",
    "    if analysts:\n",
    "        for analyst in analysts:\n",
    "            print(f\"姓名: {analyst.name}\")\n",
    "            print(f\"隶属关系: {analyst.affiliation}\")\n",
    "            print(f\"角色: {analyst.role}\")\n",
    "            print(f\"描述: {analyst.description}\")\n",
    "            print(\"-\" * 50)  "
   ]
  },
