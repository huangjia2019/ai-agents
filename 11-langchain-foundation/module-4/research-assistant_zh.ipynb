   "source": [
    "## 进行采访\n",
    "\n",
    "### 生成问题\n",
    "\n",
    "分析师将向专家提问。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e5d5f559-f42e-442b-87cd-dbf0a91abf9c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import operator\n",
    "from typing import  Annotated\n",
    "from langgraph.graph import MessagesState\n",
    "\n",
    "class InterviewState(MessagesState):\n",
    "    max_num_turns: int # 对话轮数\n",
    "    context: Annotated[list, operator.add] # 源文档\n",
    "    analyst: Analyst # 提问的分析师\n",
    "    interview: str # 采访记录\n",
    "    sections: list # 我们在外部状态中为 Send() API 复制的最终键\n",
    "\n",
    "class SearchQuery(BaseModel):\n",
    "    search_query: str = Field(None, description=\"用于检索的搜索查询。\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1c2e71eb-07ad-4bea-aabc-dbaf551408c0",
   "metadata": {},
   "outputs": [],
   "source": [
    "question_instructions = \"\"\"您是一名分析师，负责采访专家以了解特定主题。\n",
    "\n",
    "您的目标是归纳出与您的主题相关的有趣和具体的见解。\n",
    "\n",
    "1. 有趣：人们会发现令人惊讶或不明显的见解。\n",
    "        \n",
    "2. 具体：避免泛泛而谈，包括来自专家的具体例子的见解。\n",
    "\n",
    "这是您的关注主题和目标集: {goals}\n",
    "        \n",
    "首先使用符合您角色的姓名介绍自己，然后提出您的问题。\n",
    "\n",
    "继续提问以深入了解和完善您对主题的理解。\n",
    "        \n",
    "当您对理解感到满意时，用以下话结束采访："非常感谢您的帮助！"\n",
    "\n",
    "记住在整个回应中保持角色，反映提供给您的角色和目标。\"\"\"\n",
    "\n",
    "def generate_question(state: InterviewState):\n",
    "    \"\"\" 生成问题的节点 \"\"\"\n",
    "\n",
    "    # 获取状态\n",
    "    analyst = state[\"analyst\"]\n",
    "    messages = state[\"messages\"]\n",
    "\n",
    "    # 生成问题\n",
    "    system_message = question_instructions.format(goals=analyst.persona)\n",
    "    question = llm.invoke([SystemMessage(content=system_message)]+messages)\n",
    "        \n",
    "    # 将消息写入状态\n",
    "    return {\"messages\": [question]}"
   ]
  },
