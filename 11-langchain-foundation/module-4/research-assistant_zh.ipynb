   "metadata": {},
   "outputs": [],
   "source": [
    "# 我们现在更新状态，就好像我们是 human_feedback 节点\n",
    "graph.update_state(thread, {\"human_analyst_feedback\": \n",
    "                                \"加入生成式 AI 原生初创公司的 CEO\"}, as_node=\"human_feedback\")"
   ]
